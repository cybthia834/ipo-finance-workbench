# Copy approved values into deploy/.env.runtime; restrict it to the runtime account.
# Never use the local demo database or demo passwords for an internal pilot.
APP_ENV=production
DEMO_MODE=false
DATABASE_URL=postgresql+psycopg://finance_app:REPLACE_VIA_APPROVED_SECRET_INJECTION@database:5432/finance
APP_ORIGIN=https://finance.example.internal:8443
TRUSTED_HOSTS=finance.example.internal
DIRECTORY_ONLY=true
UPLOAD_ENABLED=false
AI_ENABLED=false
AUDIT_REQUIRED=true
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
EXPORT_TTL_HOURS=24
EXPORT_STORAGE_ROOT=/data/exports
