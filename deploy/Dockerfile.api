# Replace the base image with an IT-approved digest when producing an internal release.
ARG PYTHON_IMAGE=python:3.14-slim
FROM ${PYTHON_IMAGE}
WORKDIR /workspace
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/workspace/backend
COPY backend/requirements.lock /workspace/requirements.lock
RUN pip install --no-cache-dir -r /workspace/requirements.lock \
    && groupadd --gid 10001 finance \
    && useradd --uid 10001 --gid 10001 --no-create-home finance
COPY backend /workspace/backend
USER 10001:10001
EXPOSE 18080
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "18080", "--no-access-log"]
